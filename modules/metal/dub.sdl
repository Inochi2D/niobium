name "metal"
description "Metal backend for Niobium."

targetPath "out/"
targetName "niobium-mtl"
importPaths "../../source" "../nir/source"

dependency "metal-d" version=">=0.5.2"
dependency "numem" version=">=1.6.13"
dependency "nulib" version=">=0.4.8"
dependency "nulib:threading" version="*"

buildRequirements "allowWarnings"

configuration "metal" {
    platforms "osx" "ios" "tvos" "watchos" "visionos"
    lflags "-all_load"
    
    targetType "staticLibrary"
}

configuration "none" {
    targetType "none"
}